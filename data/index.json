  "accessed": "2026-10-29",
  "items": [
   {
    "en": "Eat fruit and vegetables every day: at least 400 g a day in total. Frozen or canned count too if they have no added sugar or a lot of salt."
   },
   {
    "en": "Make beans, lentils, chickpeas or dried peas a regular part of meals."
   },
   {
    "en": "Pick whole grains when you can: oats, brown rice, maize, millet, wheat."
   },
   {
    "en": "Keep salt under 5 g a day, counting salty sauces like soy and fish sauce."
   },
   {
    "en": "Go easy on sugar and sweet drinks. Even unsweetened juice is high in sugar."
   },
   {
    "en": "Cook with plant oils more than lard or butter. Boil or steam more often than you fry."
   }
  ]
 }
