 "techniques": [
  {
   "id": "fluffy_rice",
   "title": {
    "en": "Fluffy rice in one pot"
   },
   "body": {
    "en": "Use about 1 cup of rice to 2 cups of cold water, or the ratio on the package. Bring to a boil over medium-high heat, then lower the heat and simmer covered until the rice is cooked. Season with salt."
   },
   "source_url": "https://extension.umd.edu/resource/cooking-rice",
   "accessed": "2026-10-29"
  },
  {
   "id": "refrito",
   "title": {
    "en": "Start with a refrito"
   },
   "body": {
    "en": "Many Andean dishes start with an aderezo or refrito: fry finely chopped onion, garlic and ground aji in oil until golden, then add the main ingredient and the water."
   },
   "source_url": "https://cdn.www.gob.pe/uploads/document/file/3895978/RECETAS%20OLLAS%20COMUNES%20CUARTA%20SEMANA.pdf",
   "accessed": "2026-10-29"
  },
  {
   "id": "altitude_pulses",
   "title": {
    "en": "Beans and lentils at altitude"
   },
   "body": {
    "en": "Dried pulses take longer to cook the higher you live. A rule of thumb is about 5 percent more time for each 1,000 feet above 2,000 feet. A pressure cooker offsets this; still adjust the time."
   },
   "source_url": "https://extension.colostate.edu/resource/cooking-with-dry-beans-and-other-pulses/",
   "accessed": "2026-10-29",
   "regions": [
    "pe-highland",
    "bo-altiplano",
    "ec-sierra"
   ]
  },
  {
   "id": "soak_pulses",
   "title": {
    "en": "Soak dried pulses; skip hard water"
   },
   "body": {
    "en": "Soaking dried pulses shortens cooking. Hard water can keep them from softening."
   },
   "source_url": "https://extension.colostate.edu/resource/cooking-with-dry-beans-and-other-pulses/",
   "accessed": "2026-10-29"
  },
  {
   "id": "yuca_safe_prep",
   "title": {
    "en": "Cook yuca safely"
   },
   "body": {
    "en": "Peel yuca fully, since cyanide is much higher in the peel. Raw or not fully processed yuca can cause poisoning. Bitter taste is not a reliable guide, simple boiling is not always enough, and part of the toxin goes into the cooking water."
   },
   "source_url": "https://www.fao.org/4/t0207e/T0207E08.htm",
   "accessed": "2026-10-29",
   "regions": [
    "ec-coast",
    "ec-amazon",
    "pe-amazon"
   ]
  }
 ],
 "safety": [
  {
   "id": "red_flags",
   "title": {
    "en": "Get help now: red flags"
   },
   "body": {
    "en": "Bloody diarrhea, diarrhea for more than 3 days, a fever over 102 F, vomiting so often you cannot keep liquids down, or signs of dehydration (not urinating much, dry mouth and throat, dizzy when standing): contact your mission nurse now."
   },
   "source_url": "https://www.cdc.gov/food-safety/signs-symptoms/index.html",
   "accessed": "2026-10-29",
   "urgent": true
  },
  {
   "id": "water_boil",
   "title": {
    "en": "Boil water to make it safe"
   },
   "body": {
    "en": "Follow your mission's water guidance first. If you must boil: bring clear water to a rolling boil for 1 minute."
   },
   "source_url": "https://www.cdc.gov/water-emergency/about/",
   "accessed": "2026-10-29"
  },
  {
   "id": "water_altitude",
   "title": {
    "en": "Boiling at high altitude"
   },
   "body": {
    "en": "Above 6,500 feet (about 2,000 m), boil for 3 minutes."
   },
   "source_url": "https://www.cdc.gov/water-emergency/about/",
   "accessed": "2026-10-29",
   "regions": [
    "pe-highland",
    "bo-altiplano",
    "ec-sierra"
   ]
  },
  {
   "id": "water_filters",
   "title": {
    "en": "Filters and chemicals do not cover everything"
   },
   "body": {
    "en": "Portable filters do not remove all germs, and chemical disinfectants may not kill parasites. When in doubt, use your mission's guidance."
   },
   "source_url": "https://www.cdc.gov/water-emergency/about/",
   "accessed": "2026-10-29"
  },
  {
   "id": "produce",
   "title": {
    "en": "Wash produce under running water"
   },
   "body": {
    "en": "Rinse fresh fruits and vegetables under running water before eating or cooking."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "leftovers",
   "title": {
    "en": "Leftovers without a fridge"
   },
   "body": {
    "en": "Do not leave cooked food out more than 2 hours, or 1 hour in hot weather (above 90 F / 32 C). Reheat leftovers to 165 F (74 C), checked with a food thermometer."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "five_keys",
   "title": {
    "en": "WHO five keys to safer food"
   },
   "body": {
    "en": "Keep clean. Separate raw and cooked. Cook thoroughly. Keep food at safe temperatures. Use safe water and raw materials."
   },
   "source_url": "https://www.who.int/publications/i/item/9789241594639",
   "accessed": "2026-10-29"
  },
  {
   "id": "ors",
   "title": {
    "en": "Diarrhea: ORS packets and red flags"
   },
   "body": {
    "en": "Use oral rehydration salts (ORS), mixed as the packet says. Tell your mission nurse if there is blood in the stool or there are signs of dehydration: very sleepy, sunken eyes, cannot drink, skin that goes back slowly when pinched. For how many days is too long, see the Get help now: red flags card."
   },
   "source_url": "https://www.who.int/news-room/fact-sheets/detail/diarrhoeal-disease",
   "accessed": "2026-10-29"
  },
  {
   "id": "heat",
   "title": {
    "en": "Heat and hydration"
   },
   "body": {
    "en": "Drink plenty of fluids through the day. Light yellow or clear urine usually means enough. Watch for cramps, heavy sweating, dizziness, headache, weakness or nausea; rest in shade."
   },
   "source_url": "https://www.cdc.gov/heat-health/about/index.html",
   "accessed": "2026-10-29",
   "regions": [
    "pe-coast",
    "pe-amazon",
    "bo-lowlands",
    "ec-coast",
    "ec-amazon"
   ]
  },
  {
   "id": "altitude_illness",
   "title": {
    "en": "Altitude sickness"
   },
   "body": {
    "en": "Risk starts at sleeping altitudes of 2,450 m (8,000 ft) and up. Mild altitude sickness feels like a hangover, with headache the main sign. Confusion, poor balance or drowsiness can be signs of high-altitude cerebral edema (HACE). Chest congestion, cough and breathlessness on exertion can be signs of high-altitude pulmonary edema (HAPE). Do not go higher to sleep with symptoms. Descending 300 m (1,000 ft) or more helps; if you get worse, go lower and tell your mission nurse."
   },
   "source_url": "https://www.cdc.gov/yellow-book/hcp/environmental-hazards-risks/high-altitude-travel-and-altitude-illness.html",
   "accessed": "2026-10-29",
   "regions": [
    "pe-highland",
    "bo-altiplano",
    "ec-sierra"
   ]
  }
 ],
