  {
   "id": "pap",
   "name": {
    "en": "Pap (ogi / akamu porridge)"
   },
   "local_name": "ogi / akamu",
   "meal": "breakfast",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "maize",
    "millet",
    "sorghum"
   ],
   "ingredients": [
    {
     "en": "Ogi (pap) paste of corn, millet or sorghum"
    },
    {
     "en": "Water"
    },
    {
     "en": "Sugar or milk if available"
    }
   ],
   "steps": [
    {
     "en": "Mix paste with a little cool water until smooth, like thin cream."
    },
    {
     "en": "Boil water. Lower heat and pour the paste in slowly, stirring in one direction."
    },
    {
     "en": "Stir until it turns translucent and thick. Simmer 1-2 minutes."
    },
    {
     "en": "Thin with hot water if stiff. Serve with akara or moi moi if you have them."
    }
   ],
