  {
   "id": "waakye",
   "name": {
    "en": "Waakye (rice and beans)"
   },
   "local_name": "waakye",
   "meal": "main",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "rice",
    "black_eyed_peas"
   ],
   "ingredients": [
    {
     "en": "Beans (red or black-eyed), soaked 3-4 hours"
    },
    {
     "en": "Rice"
    },
    {
     "en": "Baking soda (colour) or sorghum leaves"
    },
    {
     "en": "Salt, water"
    },
    {
     "en": "To serve: pepper sauce, boiled egg"
    }
   ],
   "steps": [
    {
     "en": "Soak beans 3-4 hours, drain, boil about 45 minutes."
    },
    {
     "en": "Add baking soda or sorghum leaves for colour (take leaves out after 5 minutes)."
    },
    {
     "en": "Add washed rice and more water. Cook 15-20 minutes, stirring, until the water is gone and rice is soft."
    },
    {
     "en": "Salt. Serve with pepper sauce and a boiled egg."
    }
   ],
   "regions": [
    "gh"
   ],
   "source_url": "https://ricetoday.irri.org/waakye-a-popular-dish-from-ghana-made-with-rice-and-beans/",
   "accessed": "2026-10-29",
   "total_minutes": 100,
   "active_minutes": 100,
   "allergens": [
    "egg"
   ]
  },
  {
   "id": "red-red",
   "name": {
    "en": "Red red (bean stew with fried plantain)"
   },
   "local_name": "red red",
   "meal": "main",
   "serves": 2,
   "needs": [
    "two_burners"
   ],
   "staples": [
    "black_eyed_peas",
    "plantain",
    "palm_oil",
    "tomato"
   ],
   "ingredients": [
    {
     "en": "Black-eyed beans"
    },
    {
     "en": "Palm oil, onion, ginger, hot pepper"
    },
    {
     "en": "Tomatoes, tomato puree, salt"
    },
    {
     "en": "Ripe plantain and oil for frying"
    },
    {
     "en": "A little gari to sprinkle"
    }
   ],
   "steps": [
    {
     "en": "Boil dried beans in plenty of water until tender (about 1 hour), drain."
    },
    {
     "en": "Soften onion, ginger and pepper in the oil. Add tomatoes and puree, simmer 45-60 minutes."
    },
    {
     "en": "Add beans, simmer about 30 minutes, stirring."
    },
    {
     "en": "Shallow-fry plantain slices until golden. Serve with a little gari on top."
    }
   ],
   "regions": [
    "gh"
   ],
   "source_url": "https://www.lovefood.com/recipes/71106/red-red-stew-recipe",
   "accessed": "2026-10-29",
   "total_minutes": 150,
   "active_minutes": 150,
   "allergens": []
  },
  {
   "id": "ewa-riro",
   "name": {
    "en": "Ewa riro (stewed beans)"
   },
   "local_name": "ewa riro",
   "meal": "main",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "black_eyed_peas",
    "palm_oil",
    "tomato"
   ],
   "ingredients": [
    {
     "en": "Beans (honey, drum or black-eyed)"
    },
    {
     "en": "Onion, scotch bonnet pepper"
    },
    {
     "en": "Palm oil, bouillon cube, salt"
    }
   ],
   "steps": [
    {
     "en": "Pick over and rinse beans. Simmer with chopped onion in about 3 times their volume of water for 1-1.5 hours until soft (pressure cooker is faster, not required)."
    },
    {
     "en": "Chop second onion and pepper very fine. Fry in hot palm oil with seasoning 15-20 minutes."
    },
    {
     "en": "Stir beans and their liquid into the sauce. Simmer about 10 minutes."
    },
    {
     "en": "Eat plain or with garri, yam or plantain."
    }
   ],
   "regions": [
    "ng-south"
   ],
   "source_url": "https://eatwellabi.com/nigerian-beans-porridge-ewa-riro/",
   "accessed": "2026-10-29",
   "total_minutes": 90,
   "active_minutes": 90,
   "allergens": []
  },
  {
   "id": "hausa-koko",
   "name": {
    "en": "Hausa koko (spiced porridge)"
   },
   "local_name": "hausa koko",
   "meal": "breakfast",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "maize",
    "millet"
   ],
   "ingredients": [
    {
     "en": "Fermented corn or millet dough"
    },
    {
     "en": "Water"
    },
    {
     "en": "Cloves, ginger, chilli, salt"
    },
    {
     "en": "Sugar, evaporated milk to taste"
    }
   ],
   "steps": [
    {
     "en": "Crumble the dough into cold water and stir to a smooth paste."
    },
    {
     "en": "Pour in boiling water, stir hard until it thickens and smooths out."
    },
    {
     "en": "Add spices and salt. Simmer on low about 10 minutes."
    },
    {
     "en": "Sweeten to taste."
    }
   ],
   "regions": [
    "gh"
   ],
