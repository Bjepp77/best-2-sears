  {
   "id": "egg-sauce-yam",
   "name": {
    "en": "Egg sauce with boiled yam"
   },
   "local_name": "egg sauce and yam",
   "meal": "breakfast",
   "serves": 2,
   "needs": [
    "two_burners"
   ],
   "staples": [
    "yam",
    "eggs",
    "tomato"
   ],
   "ingredients": [
    {
     "en": "Yam"
    },
    {
     "en": "Eggs"
    },
    {
     "en": "Tomato, onion, pepper"
    },
    {
     "en": "Oil, seasoning cube, salt"
    }
   ],
   "steps": [
    {
     "en": "Peel yam, cut in chunks, rinse, boil in salted water until a fork goes in easily."
    },
    {
     "en": "Fry chopped pepper, tomato and onion in oil 4-5 minutes."
    },
    {
     "en": "Add seasoning. Pour in beaten eggs, let set a moment, then scramble."
    },
    {
     "en": "Serve over the yam."
    }
   ],
