  {
   "id": "gari-foto",
   "name": {
    "en": "Gari foto (gari with eggs and vegetables)"
   },
   "local_name": "gari foto",
   "meal": "breakfast",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "cassava_gari",
    "eggs",
    "tomato"
   ],
   "ingredients": [
    {
     "en": "Gari"
    },
    {
     "en": "Onion, tomato, chilli, ginger"
    },
    {
     "en": "Carrot, green beans, green pepper"
    },
    {
     "en": "Eggs, oil, salt"
    }
   ],
   "steps": [
    {
     "en": "Mix salt into a little water. Sprinkle over the gari until damp, not wet."
    },
    {
     "en": "Blanch the diced vegetables in salted water, drain."
    },
    {
     "en": "Soften onion in oil, add ginger, tomato, chilli, cook down."
    },
    {
     "en": "Add vegetables about 5 minutes. Turn off heat, fold in the gari."
    },
    {
     "en": "Top with cooked eggs."
    }
   ],
