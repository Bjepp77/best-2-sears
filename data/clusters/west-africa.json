   "id": "miyan-taushe",
   "name": {
    "en": "Miyan taushe (pumpkin and peanut soup)"
   },
   "local_name": "miyan taushe",
   "meal": "main",
   "serves": 2,
   "needs": [
    "burner",
    "blender"
   ],
   "staples": [
    "pumpkin",
    "groundnut",
    "tomato",
    "palm_oil"
   ],
   "ingredients": [
    {
     "en": "Meat (goat) or substitute"
    },
    {
     "en": "Pumpkin chunks"
    },
    {
     "en": "Roasted peanuts, ground"
    },
    {
     "en": "Tomato, onion, pepper"
    },
    {
     "en": "Spinach, palm oil, crayfish, salt"
    }
   ],
   "steps": [
    {
     "en": "Braise meat with onion and pepper about 30 minutes."
    },
    {
     "en": "Blend tomato, onion and pepper, cook down to a thick paste."
    },
    {
     "en": "Boil pumpkin in the pot about 15 minutes, mash it."
    },
    {
     "en": "Stir in ground peanuts, tomato paste and crayfish for 5 minutes."
    },
    {
     "en": "Add palm oil and greens, cook 10 minutes on low. Serve with tuwo shinkafa or rice."
    }
   ],
