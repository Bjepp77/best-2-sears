 "techniques": [
  {
   "id": "clean",
   "title": {
    "en": "Clean hands and surfaces"
   },
   "body": {
    "en": "Wash hands with soap for at least 20 seconds. Wash utensils, boards and counters with hot, soapy water after each food. Rinse fresh produce under running water."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "separate",
   "title": {
    "en": "Keep raw and cooked apart"
   },
   "body": {
    "en": "Use separate boards and plates for raw meat, fish and eggs, and for food ready to eat. Raw chicken does not need washing."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "cook",
   "title": {
    "en": "Cook thoroughly"
   },
   "body": {
    "en": "Cook meat, fish and eggs through. Reheat leftovers and casseroles to 165 F (74 C), checked with a food thermometer."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "keys",
   "title": {
    "en": "Five keys to safer food"
   },
   "body": {
    "en": "Keep clean. Separate raw and cooked. Cook thoroughly. Keep food at safe temperatures. Use safe water and raw materials."
   },
   "source_url": "https://www.who.int/publications/i/item/9789241594639",
   "accessed": "2026-10-29"
  },
  {
   "id": "water-cook",
   "title": {
    "en": "Use safe water for cooking"
   },
   "body": {
    "en": "Cook and wash food with water that is safe to drink. Follow your mission's water guidance first."
   },
   "source_url": "https://www.cdc.gov/water-emergency/about/",
   "accessed": "2026-10-29"
  },
  {
   "id": "cassava-safe",
   "title": {
    "en": "Make cassava safe to eat"
   },
   "body": {
    "en": "All parts of the cassava plant can release cyanide, and the peel holds the most. Bitterness is not a reliable sign of how much a root holds. Peel roots, then soak them a long time (a short soak of about 4 hours does not work), squeeze out the water and cook fully. Start root pieces in cold water, not boiling water. Boil cassava leaves well; in FAO tests, leaves boiled 30 minutes kept less cyanide than leaves boiled 15 minutes. Gari is fermented, pressed and roasted, which removes most of the cyanide."
   },
   "source_url": "https://www.fao.org/4/t0207e/T0207E08.htm",
   "accessed": "2026-10-29"
  }
 ],
 "safety": [
  {
   "id": "red-flags",
   "urgent": true,
   "title": {
    "en": "Red flags: contact your mission nurse now"
   },
   "body": {
    "en": "Contact your mission nurse now if you have bloody diarrhoea, a high fever (over 102 F / 38.9 C), vomiting so often you cannot keep liquids down, very little or no urine, a dry mouth and throat, or dizziness when you stand up. Also call if diarrhoea lasts more than 3 days."
   },
   "source_url": "https://www.cdc.gov/food-safety/signs-symptoms/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "water",
   "title": {
    "en": "Drinking water"
   },
   "body": {
    "en": "Follow your mission's water guidance first. If you must boil: let cloudy water settle or filter it, bring to a full rolling boil for 1 minute (3 minutes above 6,500 ft / about 2,000 m), cool, store in a clean covered container."
   },
   "source_url": "https://www.cdc.gov/water-emergency/about/",
   "accessed": "2026-10-29"
  },
  {
   "id": "produce",
   "title": {
    "en": "Washing produce"
   },
   "body": {
    "en": "Rinse fresh produce under running safe water. Cut melon and unwashed produce are higher-risk foods."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "leftovers",
   "title": {
    "en": "Leftovers without a fridge"
   },
   "body": {
    "en": "Do not leave cooked food out more than 2 hours (1 hour if hotter than 90 F / 32 C). Cook smaller amounts. Reheat leftovers to 165 F (74 C), checked with a food thermometer."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "hands",
   "title": {
    "en": "Hand washing"
   },
   "body": {
    "en": "Wash hands with soap for at least 20 seconds before cooking and eating, and after touching raw meat or fish."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "ors",
   "title": {
    "en": "Diarrhoea: ORS and red flags"
   },
   "body": {
    "en": "Use oral rehydration salts (ORS). Tell your mission nurse if you see blood in stool or signs of dehydration (sunken eyes, drinking poorly, very tired). For how many days is too long, see the red flags card."
   },
   "source_url": "https://www.who.int/news-room/fact-sheets/detail/diarrhoeal-disease",
   "accessed": "2026-10-29"
  },
  {
   "id": "heat",
   "title": {
    "en": "Heat and hydration"
   },
   "body": {
    "en": "Carry water and refill it. Light yellow or clear urine usually means you are drinking enough. Take breaks in shade. Cramps, heavy sweating, dizziness, headache or nausea: rest and cool down."
   },
   "source_url": "https://www.cdc.gov/heat-health/about/index.html",
   "accessed": "2026-10-29"
  },
  {
   "id": "raw",
   "title": {
    "en": "Higher-risk foods"
   },
   "body": {
    "en": "Take extra care with raw or undercooked meat, fish and eggs, raw sprouts, cut melon and unpasteurised milk."
   },
   "source_url": "https://www.cdc.gov/food-safety/prevention/index.html",
   "accessed": "2026-10-29"
  }
 ],
