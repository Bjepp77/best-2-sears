 "recipes": [
  {
   "id": "frijoles-de-la-olla",
   "name": {
    "en": "Pot beans"
   },
   "local_name": "frijoles de la olla",
   "meal": "main",
   "serves": 4,
   "needs": [
    "burner"
   ],
   "staples": [
    "black-beans",
    "onion",
    "garlic",
    "cooking-fat"
   ],
   "ingredients": [
    {
     "en": "500 g black beans, rinsed"
    },
    {
     "en": "3 L water"
    },
    {
     "en": "2 cups chopped onion"
    },
    {
     "en": "2 cloves garlic"
    },
    {
     "en": "3 tbsp lard or oil"
    },
    {
     "en": "Epazote or cilantro"
    },
    {
     "en": "Salt"
    }
   ],
   "steps": [
    {
     "en": "Put beans, water, onion, garlic and fat in a big pot. No soaking needed."
    },
    {
     "en": "Cook at medium heat 2 to 3 hours until soft (about 30 to 35 minutes in a pressure cooker). Mostly hands-off."
    },
    {
     "en": "Add salt only at the end, then boil 5 minutes uncovered with the herb."
    }
   ],
   "regions": [
    "mx-north",
    "mx-central",
    "mx-south"
   ],
   "source_url": "https://www.eluniversal.com.mx/menu/como-hacer-frijoles-de-la-olla/",
   "accessed": "2026-10-29",
   "total_minutes": 150,
   "active_minutes": 150,
   "allergens": []
  },
  {
   "id": "pupusas-revueltas",
   "name": {
    "en": "Pupusas with cheese and beans"
   },
   "local_name": "pupusas revueltas",
   "meal": "main",
   "serves": 4,
   "needs": [
    "burner"
   ],
   "staples": [
    "masa-harina",
    "fresh-cheese",
    "red-beans"
   ],
   "ingredients": [
    {
     "en": "4 cups masa harina"
    },
    {
     "en": "1 tsp salt"
    },
    {
     "en": "About 3 cups warm water"
    },
    {
     "en": "Filling: cheese and refried beans"
    }
   ],
   "steps": [
    {
     "en": "Mix masa, salt and warm water into a soft dough."
    },
    {
     "en": "Press a ball into a cup shape, add 1 to 2 tbsp filling, close and flatten to about 10 cm."
    },
    {
     "en": "Cook on a dry hot griddle or pan 3 to 4 minutes per side. Makes about 10."
    }
   ],
   "regions": [
    "sv"
   ],
   "source_url": "https://www.ikea.com/us/en/rooms/kitchen/how-to/pupusas-revueltas-pub48fdd220",
   "accessed": "2026-10-29",
   "total_minutes": 40,
   "active_minutes": 40,
   "allergens": [
    "milk"
   ]
  },
  {
   "id": "curtido",
   "name": {
    "en": "Quick cabbage slaw"
   },
   "local_name": "curtido",
   "meal": "snack",
   "serves": 4,
   "needs": [
    "burner",
    "fridge"
   ],
   "staples": [
    "cabbage",
    "carrot"
   ],
   "ingredients": [
    {
     "en": "Shredded cabbage"
    },
    {
     "en": "1 grated carrot"
    },
    {
     "en": "Oregano"
    },
    {
     "en": "1 cup hot water"
    },
    {
     "en": "1 cup vinegar"
    },
    {
     "en": "1 tsp salt"
    },
    {
     "en": "1 tsp sugar"
    }
   ],
   "steps": [
    {
     "en": "Mix cabbage, carrot and oregano in a bowl."
    },
    {
     "en": "Stir hot water, vinegar, salt and sugar together and pour over."
    },
    {
     "en": "Rest 3 to 4 hours in the fridge before serving."
    }
   ],
   "regions": [
    "sv"
   ],
   "source_url": "https://www.acozykitchen.com/how-to-make-pupusas",
   "accessed": "2026-10-29",
   "total_minutes": 15,
   "active_minutes": 15,
   "allergens": []
  },
  {
   "id": "frijoles-volteados",
   "name": {
    "en": "Turned beans"
   },
   "local_name": "frijoles volteados",
   "meal": "light",
   "serves": 3,
   "needs": [
    "burner"
   ],
   "staples": [
    "black-beans",
    "onion",
    "garlic",
    "cooking-fat",
    "fresh-cheese",
    "cream"
   ],
   "ingredients": [
    {
     "en": "Black beans, soaked overnight"
    },
    {
     "en": "8 cups water"
    },
    {
     "en": "1/2 onion"
    },
    {
     "en": "3 cloves garlic"
    },
    {
     "en": "2 to 3 tbsp oil or lard"
    },
    {
     "en": "Fresh cheese and cream to serve"
    }
   ],
   "steps": [
    {
     "en": "Simmer soaked beans with water, onion and garlic about 2 hours on low. Mostly hands-off."
    },
    {
     "en": "Add salt in the last 30 minutes."
    },
    {
     "en": "Fry in oil, mashing, 15 to 20 minutes until thick. Serve with cheese and cream."
    }
   ],
   "regions": [
    "gt"
   ],
   "source_url": "https://livinginguatemala.com/es/recetas/frijoles-volteados/",
   "accessed": "2026-10-29",
   "total_minutes": 150,
   "active_minutes": 150,
   "allergens": [
    "milk"
   ],
   "soak_hours": 8
  },
  {
   "id": "baleadas",
   "name": {
    "en": "Honduran flour tortilla with beans"
   },
   "local_name": "baleadas",
   "meal": "breakfast",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "wheat-flour",
    "red-beans",
    "fresh-cheese",
    "cream"
   ],
   "ingredients": [
    {
     "en": "120 g flour"
    },
    {
     "en": "3 g salt"
    },
    {
     "en": "Pinch baking powder"
    },
    {
     "en": "25 ml oil"
    },
    {
     "en": "About 60 ml warm water"
    },
    {
     "en": "200 g cooked red beans"
    },
    {
     "en": "Chili"
    },
    {
     "en": "Crumbled fresh cheese"
    },
    {
     "en": "Cream"
    }
   ],
   "steps": [
    {
     "en": "Mix flour, salt, baking powder, oil and warm water. Rest 30 minutes."
    },
    {
     "en": "Roll thin and cook on a hot dry pan until spotted. Makes 4."
    },
    {
     "en": "Mash the cooked beans in a little oil with chili. Spread on a tortilla, top with cheese and cream, fold."
    }
   ],
   "regions": [
    "hn"
   ],
   "source_url": "https://www.directoalpaladar.com/recetas-vegetarianas/baleada-hondurena-esta-receta-base-que-puedes-enriquecer-al-gusto-tal-cual-deliciosa",
   "accessed": "2026-10-29",
   "total_minutes": 35,
   "active_minutes": 35,
   "allergens": [
    "wheat",
    "milk"
   ]
  },
  {
   "id": "calabacitas",
   "name": {
    "en": "Zucchini with corn and tomato"
   },
   "local_name": "calabacitas a la mexicana",
   "meal": "main",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "zucchini",
    "onion",
    "tomato",
    "garlic",
    "fresh-cheese",
    "cilantro",
    "maize"
   ],
   "ingredients": [
    {
     "en": "1 zucchini, diced"
    },
    {
     "en": "1/2 onion"
    },
    {
     "en": "1 tomato"
    },
    {
     "en": "100 g corn kernels"
    },
    {
     "en": "2 cloves garlic"
    },
    {
     "en": "Serrano chili, optional"
    },
    {
     "en": "Fresh cheese and cilantro to serve"
    }
   ],
   "steps": [
    {
     "en": "Soften onion 3 minutes, add garlic and tomato."
    },
    {
