  {
   "id": "caldo-de-res",
   "name": {
    "en": "Beef and vegetable soup"
   },
   "local_name": "caldo de res",
   "meal": "main",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "maize",
    "onion",
    "garlic",
    "carrot",
    "cabbage",
    "zucchini",
    "cilantro"
   ],
   "ingredients": [
    {
     "en": "225 g (1/2 lb) beef shank with bone"
    },
    {
     "en": "750 ml (3 cups) water"
    },
    {
     "en": "1 ear fresh corn, cut in pieces"
    },
    {
     "en": "1 small potato, peeled and halved"
    },
    {
     "en": "1/2 chayote (guisquil), peeled and quartered"
    },
    {
     "en": "1/2 carrot, cut in large chunks"
    },
    {
     "en": "1 small cabbage wedge"
    },
    {
     "en": "1/4 cup green beans, trimmed"
    },
    {
     "en": "1/2 small zucchini (guicoy), sliced thick"
    },
    {
     "en": "1/2 small white onion, quartered"
    },
    {
     "en": "1 clove garlic, whole"
    },
    {
     "en": "A few cilantro sprigs"
    },
    {
     "en": "1 mint leaf (hierba buena)"
    },
    {
     "en": "Salt"
    },
    {
     "en": "To serve: lime wedges, rice, tortillas"
    }
   ],
   "steps": [
    {
     "en": "Put the beef, water, half the onion and the garlic in a big pot. Bring to a boil, skim the foam, lower the heat, partly cover and simmer 1 hour."
    },
    {
     "en": "Add the corn, potato, carrot and the rest of the onion. Simmer 30 minutes."
    },
    {
     "en": "Add the chayote, green beans and cabbage. Simmer 15 minutes."
    },
    {
     "en": "Add the zucchini, cilantro and mint. Cook 10 minutes."
    },
    {
     "en": "Add salt to taste. Serve in deep bowls with lime, rice and warm tortillas."
    }
   ],
