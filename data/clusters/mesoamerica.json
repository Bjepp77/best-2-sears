  {
   "id": "arroz-con-pollo-hondureno",
   "name": {
    "en": "Honduran chicken and rice"
   },
   "local_name": "arroz con pollo hondureno",
   "meal": "main",
   "serves": 2,
   "needs": [
    "burner"
   ],
   "staples": [
    "rice",
    "onion",
    "garlic",
    "cooking-fat"
   ],
   "ingredients": [
    {
     "en": "2 1/2 cups water"
    },
    {
     "en": "1/2 onion"
    },
    {
     "en": "1 clove garlic"
    },
    {
     "en": "1 bay leaf"
    },
    {
     "en": "1 celery stalk with leaves"
    },
    {
     "en": "1 chicken breast"
    },
    {
     "en": "1/2 green bell pepper"
    },
    {
     "en": "1 1/2 tsp vegetable oil"
    },
    {
     "en": "1 1/2 tsp turmeric"
    },
    {
     "en": "225 g (1/2 lb) precooked rice"
    },
    {
     "en": "Salt and pepper"
    }
   ],
   "steps": [
    {
     "en": "In a pot, put the water, a quarter of the onion in chunks, half the garlic crushed, the bay leaf, half the celery and the chicken. Cook until it boils and the chicken is fully cooked."
    },
    {
     "en": "Remove the chicken, shred it, strain the broth and set it aside."
    },
    {
     "en": "Finely chop the rest of the garlic, celery and onion and the bell pepper. Heat the oil in a pan and cook the vegetables."
    },
    {
     "en": "Add the rice and turmeric and stir 2 minutes."
    },
    {
     "en": "Add the shredded chicken and enough of the broth to cover the rice (1 to 2 cups). Add salt and pepper."
    },
    {
     "en": "Cook on high until it boils. When the broth starts to reduce, lower the heat and cover. Cook until the rice is cooked and fluffy."
    }
   ],
